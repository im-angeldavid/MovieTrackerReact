# Copy to `.env.local` and fill in the real values:
#   cp .env.example .env.local
#
# NOTE: Vite only exposes variables prefixed with `VITE_` to client code via
# `import.meta.env`. Anything without that prefix is invisible to the app, so
# the name MUST keep the prefix.

# TMDB API v4 read access token.
# Find it at: Account Settings -> API -> Developer -> Application ->
#              API Access -> "API Read Access Token"
# It is sent as an Authorization: Bearer header to https://api.themoviedb.org/3/...
VITE_TMDB_ACCESS_TOKEN=

# Reminder: every VITE_ variable is inlined into the client bundle in plain
# text. Never reuse this pattern for a real secret.